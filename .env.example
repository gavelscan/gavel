# Copy to .env and fill in. .env is gitignored.
# Provider: "anthropic" (Claude) or "openai" (any OpenAI-compatible endpoint).
GAVEL_MODEL_PROVIDER=openai

# --- openai-compatible endpoint (GLM/Kimi/DeepSeek/MiniMax via a router) ---
GAVEL_API_BASE=http://localhost:20128/v1
GAVEL_API_KEY=sk-your-key-here
GAVEL_MODEL=cbcn/glm-5.2(xhigh)

# --- anthropic (uncomment to use Claude instead) ---
# GAVEL_MODEL_PROVIDER=anthropic
# GAVEL_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- posting gate (judge/watcher stay dry-run until armed) ---
# GAVEL_ARMED=1
